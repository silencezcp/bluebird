# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec for BlueBird (one-folder build).

Build with::

    D:\\DSH_Workspaces\\Ftp\\python.exe -m PyInstaller --clean --noconfirm ^
        packaging\\BlueBird.spec

Output: ``dist/BlueBird/BlueBird.exe`` plus ``dist/BlueBird/docs``.

A one-folder build is used on purpose:

* it starts instantly (a one-file build unpacks ~200 MB on every launch),
* ``docs/`` lands **beside** the exe, so the user manual can be replaced
  without rebuilding - :mod:`ftpclient.resources` looks there as well.

The QtWebEngine runtime is required by the in-app manual, so it is bundled
rather than trimmed.
"""

import os

ROOT = os.path.abspath(os.path.join(SPECPATH, os.pardir))
DOCS = os.path.join(ROOT, "docs")

# The icon and the version resource are generated by tools/make_icon.py.  If
# they are missing the build would silently produce an iconless executable, so
# say so rather than shipping one.
for _required in ("bluebird.ico", "version_info.txt"):
    if not os.path.isfile(os.path.join(SPECPATH, _required)):
        print("BlueBird build: WARNING %s is missing - run tools/make_icon.py "
              "to recreate it" % _required)

# ---------------------------------------------------------------------------
# data files that are visible next to the executable
#
# Only the **user** manual ships.  docs/开发手册.* covers the source tree,
# dependency installation and the build, so it stays in the repository; copying
# it into the distribution would hand an end user documents they cannot use.
# ---------------------------------------------------------------------------
USER_MANUAL = "\u7528\u6237\u624b\u518c"      # 用户手册, the book shipped here
datas = []

for name in (USER_MANUAL + ".html", USER_MANUAL + ".md", USER_MANUAL + ".pdf"):
    path = os.path.join(DOCS, name)
    if os.path.isfile(path):
        datas.append((path, "docs"))
    else:
        print("BlueBird build: WARNING %s is missing - run the manual build, "
              "otherwise it cannot be opened from the Help menu" % name)

shots = os.path.join(DOCS, "screenshots")
if os.path.isdir(shots):
    datas.append((shots, "docs/screenshots"))

# The licence files have to travel with the binaries: PyQt5 is GPL-3.0 and the
# Qt libraries are LGPL, and both require their terms to accompany the program.
# They sit in the folder that is handed out, so a recipient can always find
# them.
for name in ("LICENSE", "THIRD-PARTY-NOTICES.txt"):
    path = os.path.join(ROOT, name)
    if os.path.isfile(path):
        datas.append((path, "."))
    else:
        print("BlueBird build: WARNING %s is missing - the distribution would "
              "not carry its licence terms" % name)

# ---------------------------------------------------------------------------
# modules the static analysis cannot always see
# ---------------------------------------------------------------------------
hiddenimports = [
    "paramiko",
    "paramiko.ed25519key",
    "paramiko.ecdsakey",
    "PyQt5.QtSvg",
    "PyQt5.QtPrintSupport",
    "PyQt5.QtWebChannel",
    "PyQt5.QtWebEngineCore",
    "PyQt5.QtWebEngineWidgets",
]

# ---------------------------------------------------------------------------
# trim what the client never uses (keeps the bundle ~80 MB smaller)
# ---------------------------------------------------------------------------
excludes = [
    "pyftpdlib",          # test-only FTP server
    "tkinter",
    "unittest",
    "pydoc_data",
    "matplotlib", "numpy", "pandas", "scipy", "PIL", "IPython",
    "PyQt5.QtBluetooth", "PyQt5.QtDesigner", "PyQt5.QtHelp",
    "PyQt5.QtMultimedia", "PyQt5.QtMultimediaWidgets", "PyQt5.QtNfc",
    "PyQt5.QtOpenGL", "PyQt5.QtPositioning", "PyQt5.QtSql",
    "PyQt5.QtTest", "PyQt5.QtXmlPatterns", "PyQt5.QtSensors",
    "PyQt5.QtSerialPort", "PyQt5.QtWebSockets", "PyQt5.QtLocation",
]

a = Analysis(
    [os.path.join(ROOT, "run.py")],
    pathex=[ROOT],
    binaries=[],
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=excludes,
    win_no_prefer_redirects=False,
    win_private_assemblies=False,
    cipher=None,
    noarchive=False,
)

# ---------------------------------------------------------------------------
# Trim what the bundle does not need.  This runs on *files*, not Python modules,
# which is the distinction that matters: adding "PyQt5.QtXmlPatterns" to
# excludes only stops the Python binding being collected, while
# PyQt5\Qt5\bin\Qt5XmlPatterns.dll still arrives with the PyQt5 distribution
# and has to be removed here, by path.
#
# READ THIS BEFORE ADDING A DLL RULE.
#
# A filename that nothing in the Python source mentions is NOT an unused file.
# Qt's plugins import each other and QtWebEngine loads further pieces at
# runtime.  A first attempt at this list removed Qt5Positioning.dll because no
# code says "Positioning" - which broke the in-app manual completely, since
# Qt5WebEngineCore.dll imports it.  It showed up only as
# "ImportError: DLL load failed while importing QtWebEngineWidgets", with the
# manual quietly falling back to the system browser.
#
# tools/check_dll_deps.py walks the real PE import tables and reports which
# candidates something else imports.  Every .dll below was checked with it and
# has no importer in the bundle.  Run it before adding another.
#
# Kept on purpose:
#   Qt5WebEngineCore.dll (97 MB) and the DLLs it imports - Qt5Positioning,
#       Qt5Location, Qt5WebSockets - for the built-in manual viewer;
#   Qt5Quick / Qt5Qml / qml\QtQuick / qml\QtWebEngine / qml\QtWebChannel,
#       loaded by QtWebEngine;
#   qml\QtPositioning and qml\QtLocation, whose plugins import those DLLs;
#   qml\QtSql, because qmllocalstorageplugin.dll imports Qt5Sql.dll;
#   d3dcompiler_47 (4 MB), loaded dynamically by WebEngine's ANGLE backend so
#       the scanner cannot see it; it is small and dropping it risks a blank
#       manual on a virtual machine or over remote desktop;
#   Qt5Svg, because the status icons are drawn with QSvgRenderer;
#   imageformats for png/jpeg/gif/ico/bmp - icons and file previews;
#   opengl32sw - see KEEP_SOFTWARE_OPENGL below.
# ---------------------------------------------------------------------------
TRIM_PREFIXES = (
    # Qt's own translation catalogues; the app localises its own strings
    "PyQt5\\Qt5\\translations\\",
    # QML modules nothing loads, and which no remaining plugin imports
    "PyQt5\\Qt5\\qml\\Qt3D",
    "PyQt5\\Qt5\\qml\\QtSensors",
    "PyQt5\\Qt5\\qml\\QtCharts",
    "PyQt5\\Qt5\\qml\\QtDataVisualization",
    "PyQt5\\Qt5\\qml\\QtPurchasing",
    "PyQt5\\Qt5\\qml\\QtQuick3D",          # 3.8 MB, 275 files
    "PyQt5\\Qt5\\qml\\QtTest",             # for QML tests
    "PyQt5\\Qt5\\qml\\QtBluetooth",
    "PyQt5\\Qt5\\qml\\QtNfc",
    "PyQt5\\Qt5\\qml\\QtMultimedia",
    "PyQt5\\Qt5\\qml\\QtRemoteObjects",
    "PyQt5\\Qt5\\qml\\QtWebView",
    # plugins for features the client does not use
    "PyQt5\\Qt5\\plugins\\sqldrivers",     # no database
    "PyQt5\\Qt5\\plugins\\designer",       # not editing .ui files
    "PyQt5\\Qt5\\plugins\\qmltooling",     # QML debugging aids
    "PyQt5\\Qt5\\plugins\\bearer",         # no bearer management
    "PyQt5\\Qt5\\plugins\\playlistformats",
    "PyQt5\\Qt5\\plugins\\mediaservice",
    "PyQt5\\Qt5\\plugins\\audio",
    "PyQt5\\Qt5\\plugins\\geoservices",
    "PyQt5\\Qt5\\plugins\\sensorgestures",
    "PyQt5\\Qt5\\plugins\\sensors",
    "PyQt5\\Qt5\\plugins\\webview",
    # DLLs with no importer in the bundle, confirmed with check_dll_deps.py
    "PyQt5\\Qt5\\bin\\Qt5Designer.dll",
    "PyQt5\\Qt5\\bin\\Qt5Bluetooth.dll",
    "PyQt5\\Qt5\\bin\\Qt5Nfc.dll",
    "PyQt5\\Qt5\\bin\\Qt5Sensors.dll",
    "PyQt5\\Qt5\\bin\\Qt5SerialPort.dll",
    "PyQt5\\Qt5\\bin\\Qt5Multimedia.dll",
    "PyQt5\\Qt5\\bin\\Qt5MultimediaWidgets.dll",
    # image formats the client never reads
    "PyQt5\\Qt5\\plugins\\imageformats\\qwbmp.dll",
    "PyQt5\\Qt5\\plugins\\imageformats\\qtga.dll",
)

#: The software OpenGL fallback (20 MB) is kept by default.  It is what lets the
#: program start at all on a machine with no usable GPU driver - a virtual
#: machine, or a remote desktop session - which is exactly where a portable FTP
#: client tends to be run.  Set BLUEBIRD_DROP_OPENGL=1 to trade those 20 MB for
#: a possible "failed to create OpenGL context" at startup.
if os.environ.get("BLUEBIRD_DROP_OPENGL") == "1":
    TRIM_PREFIXES += ("PyQt5\\Qt5\\bin\\opengl32sw.dll",)

#: (path fragment, description) for log lines such as "lib not found: ..."
TRIM_SUBSTRINGS = ("qtquickscene2dplugin", "qtquickscene3dplugin")


def _keep(entry):
    """True when the collected file should stay in the bundle."""
    name = str(entry[0])
    normalised = name.replace("/", "\\")
    for prefix in TRIM_PREFIXES:
        if normalised.startswith(prefix):
            return False
    lowered = normalised.lower()
    for fragment in TRIM_SUBSTRINGS:
        if fragment in lowered:
            return False
    return True


# Say *what* is removed, grouped by the rule that matched.  A trim this broad is
# only safe if it can be seen: 500 files disappearing behind a single number is
# how a needed DLL gets removed without anyone noticing.
def _matched_rule(name):
    normalised = str(name).replace("/", "\\")
    for prefix in TRIM_PREFIXES:
        if normalised.startswith(prefix):
            return prefix.rstrip("\\")
    lowered = normalised.lower()
    for fragment in TRIM_SUBSTRINGS:
        if fragment in lowered:
            return fragment
    return None


# snapshot before trimming, so the report can say what went
_collected = list(a.binaries) + list(a.datas)
_before = len(_collected)
# In PyInstaller 5 these are plain lists; keep it that way for compatibility.
a.binaries = [item for item in a.binaries if _keep(item)]
a.datas = [item for item in a.datas if _keep(item)]
_after = len(a.binaries) + len(a.datas)
print("BlueBird build: trimmed %d of %d collected files"
      % (_before - _after, _before))

if os.environ.get("BLUEBIRD_TRIM_REPORT") != "0":
    _removed = {}
    for entry in _collected:
        if _keep(entry):
            continue
        rule = _matched_rule(entry[0]) or "?"
        _removed[rule] = _removed.get(rule, 0) + 1
    for rule in sorted(_removed, key=lambda key: -_removed[key]):
        print("BlueBird build:   removed %4d file(s)  %s"
              % (_removed[rule], rule))

pyz = PYZ(a.pure, a.zipped_data, cipher=None)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="BlueBird",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    # UPX corrupts several Qt DLLs, so it stays off
    upx=False,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon=os.path.join(ROOT, "packaging", "bluebird.ico")
    if os.path.isfile(os.path.join(ROOT, "packaging", "bluebird.ico")) else None,
    version=os.path.join(ROOT, "packaging", "version_info.txt")
    if os.path.isfile(os.path.join(ROOT, "packaging", "version_info.txt")) else None,
)

coll = COLLECT(
    exe,
    a.binaries,
    a.zipfiles,
    a.datas,
    strip=False,
    upx=False,
    upx_exclude=[],
    name="BlueBird",
)
